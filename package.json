{
  "name": "quick-css-modules",
  "displayName": "Quick CSS Modules",
  "description": "Smart navigation and auto-creation for CSS Modules with .d.ts filtering",
  "version": "0.0.1",
  "publisher": "your-publisher-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/quick-css-modules"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quick-css-modules.goToCSSModule",
        "title": "Go to CSS Module"
      },
      {
        "command": "quick-css-modules.revealDefinition",
        "title": "Go to Definition (CSS Modules Aware)"
      }
    ],
    "keybindings": [
      {
        "command": "quick-css-modules.revealDefinition",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus && (editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact)"
      }
    ],
    "configuration": {
      "title": "Quick CSS Modules",
      "properties": {
        "quick-css-modules.filterDeclarationFiles": {
          "type": "boolean",
          "default": true,
          "description": "Filter out .d.ts files from CSS module navigation"
        },
        "quick-css-modules.overrideGoToDefinition": {
          "type": "boolean",
          "default": false,
          "description": "Override default F12 (Go to Definition) behavior for CSS modules. Warning: This replaces the default keybinding."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
